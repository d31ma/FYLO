# Secrets only. Copy to .env beside application.json, then restrict access.
# Runtime settings belong under the fylo key in application.json.
# Uncomment and populate these only when referenced by application.json:
# "encryption": { "key": "${FYLO_ENCRYPTION_KEY}" }
# "cipher": { "salt": "${FYLO_CIPHER_SALT}" }
# FYLO_ENCRYPTION_KEY=replace-with-a-secret-of-at-least-32-characters
# FYLO_CIPHER_SALT=replace-with-a-secret-salt
