{
    "schemaVersion": 1,
    "queryFormat": "fylo.structured-query.v1",
    "producer": "fylo-js",
    "cases": [
        {
            "name": "nested coercion range like and contains",
            "document": {
                "name": "Ada Lovelace",
                "score": "42",
                "active": true,
                "tags": ["math", 7],
                "profile": { "city": "London" }
            },
            "query": {
                "$ops": [
                    {
                        "score": { "$gte": 40, "$lt": 50 },
                        "active": { "$eq": 1 },
                        "name": { "$like": "Ada%" },
                        "tags": { "$contains": "math" },
                        "profile.city": { "$eq": "London" }
                    }
                ],
                "$created": { "$lte": 10 },
                "$updated": { "$gt": 10 }
            },
            "timestamps": { "createdAt": 10, "updatedAt": 20 },
            "expected": true
        },
        {
            "name": "or of and operations",
            "document": { "role": "editor", "enabled": true },
            "query": {
                "$ops": [
                    { "role": { "$eq": "admin" }, "enabled": { "$eq": true } },
                    { "role": { "$eq": "editor" }, "enabled": { "$eq": true } }
                ]
            },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "missing loosely equals null",
            "document": {},
            "query": { "$ops": [{ "missing": { "$eq": null } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "utf16 underscore is one code unit",
            "document": { "symbol": "😀" },
            "query": { "$ops": [{ "symbol": { "$like": "_" } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": false
        },
        {
            "name": "utf16 surrogate pair takes two underscores",
            "document": { "symbol": "😀" },
            "query": { "$ops": [{ "symbol": { "$like": "__" } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "timestamp rejection",
            "document": { "name": "Ada" },
            "query": { "$updated": { "$lt": 20 } },
            "timestamps": { "createdAt": 10, "updatedAt": 20 },
            "expected": false
        },
        {
            "name": "null numeric coercion",
            "document": { "score": null },
            "query": { "$ops": [{ "score": { "$gte": 0, "$lte": 0 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "hex string equals its number",
            "document": { "n": "0x10" },
            "query": { "$ops": [{ "n": { "$eq": 16 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "hex string orders as its number",
            "document": { "n": "0x10" },
            "query": { "$ops": [{ "n": { "$gte": 16 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "signed hex string is not a number",
            "document": { "n": "-0x10" },
            "query": { "$ops": [{ "n": { "$eq": -16 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": false
        },
        {
            "name": "Infinity string is not a number",
            "document": { "n": "Infinity" },
            "query": { "$ops": [{ "n": { "$gt": 5 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": false
        },
        {
            "name": "one-element array never loosely equals",
            "document": { "age": [30] },
            "query": { "$ops": [{ "age": { "$eq": 30 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": false
        },
        {
            "name": "array never equals its joined string",
            "document": { "t": [1, 2] },
            "query": { "$ops": [{ "t": { "$eq": "1,2" } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": false
        },
        {
            "name": "array not-equal holds",
            "document": { "age": [30] },
            "query": { "$ops": [{ "age": { "$ne": 30 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "one-element boolean array orders as a number",
            "document": { "f": [true] },
            "query": { "$ops": [{ "f": { "$gte": 1 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "array index path does not resolve",
            "document": { "tags": ["a", "b"] },
            "query": { "$ops": [{ "tags.0": { "$eq": "a" } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": false
        },
        {
            "name": "array length path does not resolve",
            "document": { "tags": ["a", "b"] },
            "query": { "$ops": [{ "tags.length": { "$eq": 2 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": false
        },
        {
            "name": "empty path segments are skipped",
            "document": { "a": { "b": 1 } },
            "query": { "$ops": [{ "a..b": { "$eq": 1 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        },
        {
            "name": "contains compares loosely",
            "document": { "tags": ["7"] },
            "query": { "$ops": [{ "tags": { "$contains": 7 } }] },
            "timestamps": { "createdAt": 1, "updatedAt": 1 },
            "expected": true
        }
    ],
    "resultCases": [
        {
            "name": "stable input order with limit",
            "query": {
                "$ops": [{ "role": { "$eq": "admin" } }, { "role": { "$eq": "editor" } }],
                "$limit": 2
            },
            "rows": [
                {
                    "id": "doc-c",
                    "document": { "role": "editor" },
                    "timestamps": { "createdAt": 3, "updatedAt": 30 }
                },
                {
                    "id": "doc-a",
                    "document": { "role": "admin" },
                    "timestamps": { "createdAt": 1, "updatedAt": 10 }
                },
                {
                    "id": "doc-b",
                    "document": { "role": "editor" },
                    "timestamps": { "createdAt": 2, "updatedAt": 20 }
                }
            ],
            "expectedIds": ["doc-c", "doc-a"]
        },
        {
            "name": "zero limit retains historical unlimited behavior",
            "query": { "$ops": [], "$limit": 0 },
            "rows": [
                {
                    "id": "doc-b",
                    "document": { "value": 2 },
                    "timestamps": { "createdAt": 2, "updatedAt": 20 }
                },
                {
                    "id": "doc-a",
                    "document": { "value": 1 },
                    "timestamps": { "createdAt": 1, "updatedAt": 10 }
                }
            ],
            "expectedIds": ["doc-b", "doc-a"]
        },
        {
            "name": "timestamp filtering happens before pagination",
            "query": {
                "$updated": { "$gte": 20 },
                "$limit": 1
            },
            "rows": [
                {
                    "id": "old",
                    "document": { "value": 1 },
                    "timestamps": { "createdAt": 1, "updatedAt": 10 }
                },
                {
                    "id": "first-match",
                    "document": { "value": 2 },
                    "timestamps": { "createdAt": 2, "updatedAt": 20 }
                },
                {
                    "id": "second-match",
                    "document": { "value": 3 },
                    "timestamps": { "createdAt": 3, "updatedAt": 30 }
                }
            ],
            "expectedIds": ["first-match"]
        }
    ]
}
