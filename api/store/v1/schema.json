{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://fylo.del.ma/api/store/v1/schema.json",
    "title": "FYLO Store contract v1 (frozen, ADR 0035)",
    "$defs": {
        "scalar": {
            "oneOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "null" }
            ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "documentId": { "type": "string", "minLength": 1 },
        "entity": {
            "type": "object",
            "description": "The document's JSON object with its id under the request's idField."
        },
        "common": {
            "type": "object",
            "properties": {
                "collection": { "$ref": "#/$defs/name" },
                "namespace": { "type": "string", "default": "public" },
                "idField": { "type": "string", "minLength": 1, "default": "id" },
                "transaction": { "type": "string", "minLength": 1 }
            }
        },
        "predicate": {
            "type": "object",
            "required": ["field", "operator"],
            "additionalProperties": false,
            "properties": {
                "field": { "type": "string", "minLength": 1 },
                "operator": {
                    "enum": [
                        "eq",
                        "ne",
                        "lt",
                        "lte",
                        "gt",
                        "gte",
                        "in",
                        "isNull",
                        "isNotNull",
                        "like",
                        "match"
                    ]
                },
                "value": {
                    "oneOf": [
                        { "$ref": "#/$defs/scalar" },
                        {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 100,
                            "items": { "$ref": "#/$defs/scalar" }
                        }
                    ]
                }
            }
        },
        "order": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
                "field": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["asc", "desc"], "default": "asc" }
            }
        },
        "query": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "where": {
                    "type": "array",
                    "maxItems": 8,
                    "items": { "$ref": "#/$defs/predicate" }
                },
                "anyOf": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                        "type": "array",
                        "maxItems": 8,
                        "items": { "$ref": "#/$defs/predicate" }
                    }
                },
                "orderBy": {
                    "type": "array",
                    "maxItems": 4,
                    "items": { "$ref": "#/$defs/order" }
                }
            }
        },
        "page": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "size": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 20 },
                "offset": { "type": "integer", "minimum": 0, "default": 0 },
                "maxSize": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
            }
        },
        "scrollPage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "size": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 20 },
                "cursor": { "type": ["string", "null"] },
                "maxSize": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
            }
        },
        "write": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["save"],
                    "additionalProperties": false,
                    "properties": { "save": { "$ref": "#/$defs/entity" } }
                },
                {
                    "type": "object",
                    "required": ["patch"],
                    "additionalProperties": false,
                    "properties": {
                        "patch": {
                            "type": "object",
                            "required": ["id", "fields"],
                            "additionalProperties": false,
                            "properties": {
                                "id": { "$ref": "#/$defs/documentId" },
                                "fields": { "type": "object" }
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["deleteById"],
                    "additionalProperties": false,
                    "properties": { "deleteById": { "$ref": "#/$defs/documentId" } }
                },
                {
                    "type": "object",
                    "required": ["delete"],
                    "additionalProperties": false,
                    "properties": { "delete": { "$ref": "#/$defs/query" } }
                }
            ]
        },
        "requests": {
            "storeFindById": { "required": ["collection", "id"], "properties": { "id": { "$ref": "#/$defs/documentId" } } },
            "storeFindAll": { "required": ["collection"], "properties": { "page": { "$ref": "#/$defs/page" } } },
            "storeSave": { "required": ["collection", "entity"], "properties": { "entity": { "$ref": "#/$defs/entity" } } },
            "storePatch": {
                "required": ["collection", "id", "fields"],
                "properties": { "id": { "$ref": "#/$defs/documentId" }, "fields": { "type": "object" } }
            },
            "storeDeleteById": { "required": ["collection", "id"], "properties": { "id": { "$ref": "#/$defs/documentId" } } },
            "storeFind": {
                "required": ["collection"],
                "properties": { "query": { "$ref": "#/$defs/query" }, "page": { "$ref": "#/$defs/page" } }
            },
            "storeCount": { "required": ["collection"], "properties": { "query": { "$ref": "#/$defs/query" } } },
            "storeExists": { "required": ["collection"], "properties": { "query": { "$ref": "#/$defs/query" } } },
            "storeDelete": { "required": ["collection"], "properties": { "query": { "$ref": "#/$defs/query" } } },
            "storeScroll": {
                "required": ["collection"],
                "properties": { "query": { "$ref": "#/$defs/query" }, "page": { "$ref": "#/$defs/scrollPage" } }
            },
            "storeTransaction": {
                "required": ["collection", "writes"],
                "properties": {
                    "writes": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/write" } }
                }
            },
            "transactionBegin": {
                "required": ["collection"],
                "properties": { "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000, "default": 30000 } }
            },
            "transactionCommit": { "required": ["transaction"] },
            "transactionRollback": { "required": ["transaction"] },
            "collectionExists": { "required": ["collection"] },
            "listCollections": { "required": [] }
        },
        "results": {
            "storeFindById": { "oneOf": [{ "$ref": "#/$defs/entity" }, { "type": "null" }] },
            "storeFindAll": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
            "storeSave": { "$ref": "#/$defs/entity" },
            "storePatch": { "oneOf": [{ "$ref": "#/$defs/entity" }, { "type": "null" }] },
            "storeDeleteById": { "enum": [0, 1] },
            "storeFind": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
            "storeCount": { "type": "integer", "minimum": 0 },
            "storeExists": { "type": "boolean" },
            "storeDelete": { "type": "integer", "minimum": 0 },
            "storeScroll": {
                "type": "object",
                "required": ["content", "nextCursor"],
                "properties": {
                    "content": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
                    "nextCursor": { "type": ["string", "null"] }
                }
            },
            "storeTransaction": { "type": "array" },
            "transactionBegin": {
                "type": "object",
                "required": ["transaction"],
                "properties": { "transaction": { "type": "string" } }
            },
            "transactionCommit": {
                "type": "object",
                "required": ["committed", "writes"],
                "properties": { "committed": { "const": true }, "writes": { "type": "integer", "minimum": 0 } }
            },
            "transactionRollback": {
                "type": "object",
                "required": ["rolledBack"],
                "properties": { "rolledBack": { "const": true } }
            },
            "collectionExists": { "type": "boolean" },
            "listCollections": { "type": "array", "items": { "type": "string" } }
        }
    }
}
