{
    "name": "fylo-website",
    "version": "26.25.1",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.11",
    "scripts": {
        "start": "bun run serve",
        "serve": "bun run bundle && bun ../scripts/run-site.mjs preview",
        "bundle": "bun ../scripts/run-site.mjs bundle && bun --no-env-file ../scripts/fingerprint-assets.mjs && bun --no-env-file ../scripts/patch-tachyon-runtime.mjs .",
        "preview": "bun run bundle && bun ../scripts/run-site.mjs preview"
    }
}
