{
    "name": "FYLO",
    "short_name": "FYLO",
    "description": "FYLO is a document store that ships as a single self-contained binary with language shims for Python, Ruby, Node, Go, C#, Java, PHP, and Dart, plus a local-only browser client. One canonical JSON file per document, zero-payload prefix indexes, git-like version control, and SQL — no server, no network protocol.",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "icons": [
        {
            "src": "/shared/assets/favicon.svg",
            "sizes": "any",
            "type": "image/svg+xml"
        }
    ],
    "tac": {
        "origin": "https://fylo.del.ma",
        "names": {
            "words": ["postgrest"]
        },
        "application": {
            "id": "ma.del.fylo.website",
            "version": "26.45.7"
        },
        "scripts": ["/shared/scripts/imports.js"],
        "styles": ["/shared/assets/duvay/duvay.min.css", "/shared/assets/site.css"],
        "styleSources": {
            "/shared/assets/duvay/duvay.min.css": {
                "kind": "vendor",
                "package": "@d31ma/duvay-css",
                "version": "26.35.01-1",
                "license": "MIT",
                "sha256": "dd0b9a6841313bc3b4bf30da476dc1aa88821a58220d662b679f83873b92c768"
            },
            "/shared/assets/site.css": {
                "kind": "foundation"
            }
        },
        "cache": [
            {
                "path": "/*",
                "policy": "network-first"
            }
        ],
        "metadata": {
            "defaults": {
                "siteName": "FYLO",
                "description": "FYLO is a document store that ships as a single self-contained binary with language shims for Python, Ruby, Node, Go, C#, Java, PHP, and Dart, plus a local-only browser client. One canonical JSON file per document, zero-payload prefix indexes, git-like version control, and SQL — no server, no network protocol.",
                "image": "/shared/assets/favicon.svg"
            },
            "routes": {
                "/": {
                    "title": "FYLO — Query the files you already own."
                },
                "/docs": {
                    "title": "Docs — FYLO"
                },
                "/docs/browser": {
                    "title": "Browser & Explorer — FYLO"
                },
                "/docs/buckets": {
                    "title": "Buckets & raw files — FYLO"
                },
                "/docs/cli": {
                    "title": "CLI reference — FYLO"
                },
                "/docs/clients": {
                    "title": "Language clients — FYLO"
                },
                "/docs/concepts": {
                    "title": "Concepts — FYLO"
                },
                "/docs/documents": {
                    "title": "Documents & metadata — FYLO"
                },
                "/docs/errors": {
                    "title": "Error codes — FYLO"
                },
                "/docs/limitations": {
                    "title": "Limitations — FYLO"
                },
                "/docs/operations": {
                    "title": "Native configuration — FYLO"
                },
                "/docs/protocol": {
                    "title": "Machine protocol — FYLO"
                },
                "/docs/querying": {
                    "title": "Querying & SQL — FYLO"
                },
                "/docs/queue": {
                    "title": "Serverless queue — FYLO"
                },
                "/docs/recovery": {
                    "title": "Recovery & rebuild — FYLO"
                },
                "/docs/replication": {
                    "title": "Backup & sync — FYLO"
                },
                "/docs/schemas": {
                    "title": "Schemas & migrations — FYLO"
                },
                "/docs/security": {
                    "title": "Encryption & access — FYLO"
                },
                "/docs/versioning": {
                    "title": "Version control — FYLO"
                },
                "/download": {
                    "title": "Download — FYLO"
                }
            }
        }
    }
}
