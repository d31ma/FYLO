 /// Call xCommit on all virtual tables that participated in the current transaction.
+/// The virtual table with `id`: one created by a module, or (FYLO) an internal
+/// table in the connection's schema.
+fn find_vtab(conn: &Connection, id: u64) -> Option<Arc<crate::VirtualTable>> {
+    let created = conn
+        .syms
+        .read()
+        .vtabs
+        .values()
+        .find(|vtab| vtab.id() == id)
+        .cloned();
+    #[cfg(feature = "fylo")]
+    let created = created.or_else(|| {
+        conn.schema
+            .read()
+            .tables
+            .values()
+            .find_map(|table| match table.as_ref() {
+                crate::schema::Table::Virtual(vtab) if vtab.id() == id => Some(vtab.clone()),
+                _ => None,
+            })
+    });
+    created
+}
+
